  <meta name="description" content="Official website of Abdul Latif Ahmed (Latif Sir), Assistant Professor of Chemistry at PhysicsWallah. JEE & NEET mentor, M.Sc. (Organic Chemistry), Tezpur University.">

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #050616;
      --accent-1: #ff7a18;
      --accent-2: #ffce00;
      --accent-3: #4c6fff;
      --text-main: #f7f7ff;
      --text-muted: #c0c2dd;
      --card-bg: rgba(10, 12, 40, 0.96);
      --border-glass: 1px solid rgba(255, 255, 255, 0.12);
      --shadow-soft: 0 18px 40px rgba(0, 0, 0, 0.65);
      --radius-xl: 22px;
      --radius-lg: 18px;
      --radius-pill: 999px;
      --transition-fast: 0.25s ease;
      --transition-med: 0.4s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top left, #26153a 0, #050616 40%, #02010a 100%);
      color: var(--text-main);
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    ::selection {
      background: rgba(255, 206, 0, 0.35);
      color: #111;
    }

    /* BACKGROUND ORBS */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(42px);
      opacity: 0.85;
      z-index: -2;
      mix-blend-mode: screen;
      pointer-events: none;
      animation: floatOrbs 18s ease-in-out infinite alternate;
    }

    .orb-1 {
      width: 320px;
      height: 320px;
      background: #ff7a18;
      top: -80px;
      left: -60px;
    }

    .orb-2 {
      width: 260px;
      height: 260px;
      background: #4c6fff;
      bottom: -80px;
      right: -40px;
      animation-delay: 3s;
    }

    .orb-3 {
      width: 220px;
      height: 220px;
      background: #ffce00;
      top: 40%;
      right: 10%;
      animation-delay: 6s;
    }

    @keyframes floatOrbs {
      from { transform: translate3d(0, 0, 0); }
      to   { transform: translate3d(40px, -60px, 0); }
    }

    /* LAYOUT */
    .page-wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 16px 20px 60px;
      position: relative;
      z-index: 1;
    }

    /* NAVBAR */
    header {
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(18px);
      background: linear-gradient(to bottom, rgba(5, 6, 22, 0.96), rgba(5, 6, 22, 0.78));
      border-bottom: var(--border-glass);
    }

    .nav {
      max-width: 1180px;
      margin: 0 auto;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .logo-badge {
      width: 34px;
      height: 34px;
      border-radius: 32% 68% 51% 49%;
      background: radial-gradient(circle at 20% 20%, #ffce00, #ff7a18, #4c6fff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      box-shadow: var(--shadow-soft);
      color: #120700;
    }

    .nav-links {
      display: flex;
      gap: 18px;
      font-size: 0.9rem;
    }

    .nav-links a {
      padding: 6px 12px;
      border-radius: var(--radius-pill);
      color: var(--text-muted);
      transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    }

    .nav-links a:hover,
    .nav-links a.active {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-main);
      transform: translateY(-1px);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-primary, .btn-ghost {
      border-radius: var(--radius-pill);
      padding: 8px 18px;
      border: none;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(120deg, #ff7a18, #ffce00);
      color: #211;
      box-shadow: 0 10px 30px rgba(255, 122, 24, 0.45);
    }

    .btn-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 14px 40px rgba(255, 122, 24, 0.7);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-main);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.05);
      transform: translateY(-1px);
    }

    /* HERO SECTION */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 36px;
      align-items: center;
      padding: 60px 0 40px;
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 32px;
      }
    }

    .hero-left {
      animation: fadeUp 0.85s ease-out both;
    }

    .pill-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 12px;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.16);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 14px;
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #36ff9b;
      box-shadow: 0 0 10px #36ff9b;
    }

    .hero-title {
      font-size: clamp(2.1rem, 3.1vw, 2.8rem);
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .hero-subtitle {
      font-size: 1rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .hero-role {
      font-size: 0.95rem;
      color: #ffe9a9;
      margin-bottom: 18px;
    }

    .hero-highlight {
      font-size: 0.9rem;
      color: var(--text-muted);
      max-width: 520px;
      line-height: 1.6;
    }

    .hero-highlight span {
      color: var(--accent-2);
      font-weight: 500;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
      align-items: center;
    }

    .hero-meta {
      display: flex;
      gap: 16px;
      margin-top: 16px;
      font-size: 0.8rem;
      color: var(--text-muted);
      flex-wrap: wrap;
    }

    .hero-meta span {
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(0, 0, 0, 0.2);
    }

    /* HERO RIGHT - PROFILE */
    .hero-right {
      display: flex;
      justify-content: center;
      align-items: center;
      animation: floatCard 8s ease-in-out infinite alternate;
    }

    .profile-wrapper {
      position: relative;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      padding: 4px;
      background: conic-gradient(
        from 140deg,
        #ff7a18,
        #ffce00,
        #4c6fff,
        #ff7a18
      );
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.8);
    }

    .profile-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: radial-gradient(circle at top, #222854, #050616);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    .profile-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.03);
    }

    .profile-glow {
      position: absolute;
      inset: 10px;
      border-radius: 50%;
      box-shadow: 0 0 60px rgba(255, 206, 0, 0.35);
      pointer-events: none;
    }

    .profile-tag {
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      background: rgba(5, 6, 22, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.36);
      font-size: 0.78rem;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .profile-tag-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-2);
    }

    @keyframes floatCard {
      from { transform: translateY(0); }
      to   { transform: translateY(-12px); }
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* SECTION STYLES */
    section {
      margin-top: 50px;
    }

    .section-card {
      background: var(--card-bg);
      border-radius: var(--radius-xl);
      border: var(--border-glass);
      box-shadow: var(--shadow-soft);
      padding: 24px 22px 26px;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 14px;
      gap: 10px;
    }

    .section-title {
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title span.dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--accent-2);
      box-shadow: 0 0 12px var(--accent-2);
    }

    .section-subtitle {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* ABOUT / BIO */
    .about-text {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    .about-text strong {
      color: var(--text-main);
    }

    .quote-line {
      margin-top: 14px;
      font-style: italic;
      font-size: 0.9rem;
      color: #ffe9a9;
      border-left: 3px solid rgba(255, 206, 0, 0.7);
      padding-left: 10px;
    }

    /* TWO COLUMN LISTS */
    .two-cols {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 26px;
    }

    @media (max-width: 820px) {
      .two-cols {
        grid-template-columns: 1fr;
      }
    }

    .list-block h4 {
      font-size: 0.95rem;
      margin-bottom: 8px;
    }

    .list-block ul {
      list-style: none;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .list-block ul li {
      padding: 5px 0;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .bullet {
      margin-top: 6px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 206, 0, 0.9);
      flex-shrink: 0;
    }

    .tagline {
      margin-top: 8px;
      font-size: 0.82rem;
      color: #9ea0d2;
    }

    /* CONTACT SECTION */
    .contact-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 24px;
      align-items: center;
    }

    @media (max-width: 820px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    .contact-text {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    .contact-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    .btn-icon {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .social-note {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 8px;
    }

    .contact-card-mini {
      border-radius: var(--radius-lg);
      padding: 14px 14px 12px;
      background: radial-gradient(circle at top, rgba(76, 111, 255, 0.4), rgba(5, 6, 22, 0.98));
      border: 1px solid rgba(255, 255, 255, 0.18);
      font-size: 0.85rem;
    }

    .contact-card-mini strong {
      display: block;
      margin-bottom: 4px;
    }

    /* FOOTER */
    footer {
      margin-top: 40px;
      padding-top: 10px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.8rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    footer span {
      opacity: 0.9;
    }

    footer a {
      text-decoration: underline;
      text-decoration-style: dotted;
    }
  </style>
</head>
